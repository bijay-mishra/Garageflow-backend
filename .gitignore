bin/
obj/
*.user
.vs/
.vscode/
appsettings.*.local.json

# The real server settings: connection string, JWT signing key, SMTP password,
# merchant keys. This is the file that overrides the development defaults in
# appsettings.json, so by definition it is the one holding everything worth
# stealing. It is created on the server and never travels through the repo.
appsettings.Production.json

# Publish output.
publish/

# The API console, when it is started in the background. Holds the reset codes
# that SMTP would otherwise have emailed — never commit it.
logs/

# Company logos, uploaded at runtime. These are customers' brand assets, not
# source: they belong in whatever storage the deployment uses, and committing
# them would grow the repo by one image per company forever.
src/GarageFlow.Api/wwwroot/logos/
