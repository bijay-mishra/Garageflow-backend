<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The 10.0 GA baseline, which is what the SDK already writes into
         runtimeconfig.json by default. Stated here so a future SDK that starts
         targeting the latest installed patch instead cannot quietly raise the
         floor. Framework-dependent apps still roll forward at startup, so this
         is the minimum the app accepts, not the version it runs on. -->
    <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The XML doc file is still produced for IDE tooltips; Swagger does not
         read it (see Program.cs), so the UI stays a plain route list. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member needs a doc comment just to satisfy the compiler. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>8ec5ccc7-31cc-45ca-a49b-37239f0cc275</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.39.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
